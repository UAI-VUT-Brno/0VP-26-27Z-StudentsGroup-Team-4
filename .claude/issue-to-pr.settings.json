      "Bash(gh pr create:*)",
      "Bash(git status:*)",
      "Bash(git branch --list:*)",
      "Bash(git checkout -b:*)",
      "Bash(git diff:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git log:*)",
