# Line endings must match .editorconfig on every OS and in CI.
# .cs files are checked by "dotnet format --verify-no-changes" (end_of_line = crlf).
* text=auto

# CRLF (default of [*] in .editorconfig)
*.cs        text eol=crlf
*.csproj    text eol=crlf
*.props     text eol=crlf
*.targets   text eol=crlf
*.sln       text eol=crlf
*.json      text eol=crlf
*.yml       text eol=crlf
*.yaml      text eol=crlf
*.ps1       text eol=crlf
*.http      text eol=crlf
*.toml      text eol=crlf

# LF (explicit exceptions in .editorconfig: shell, Docker, nginx, markdown)
*.sh            text eol=lf
*.md            text eol=lf
Dockerfile      text eol=lf
Dockerfile.*    text eol=lf
.dockerignore   text eol=lf
*.conf          text eol=lf
*.env           text eol=lf
compose.yaml    text eol=lf
compose.*.yaml  text eol=lf
.git-blame-ignore-revs text eol=lf
