<Project>

  <!-- Bezpečnostní audit NuGet balíčků: platí pro všechny projekty v řešení. -->
  <PropertyGroup>
    <NuGetAudit>true</NuGetAudit>
    <!-- all = kontrolovat i tranzitivní závislosti, ne jen přímé. -->
    <NuGetAuditMode>all</NuGetAuditMode>
    <!-- low = hlásit všechny závažnosti. -->
    <NuGetAuditLevel>low</NuGetAuditLevel>
    <!-- NU1901 low, NU1902 moderate, NU1903 high, NU1904 critical: povýšit na chybu, aby restore/build selhal. -->
    <WarningsAsErrors>$(WarningsAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsAsErrors>
  </PropertyGroup>

  <!-- Statická analýza kódu (SAST) -->
  <PropertyGroup>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-All</AnalysisLevel>
    <!-- Volitelně: pokud chceš, aby i chyby v analýze kódu shodily build, odkomentuj řádek níže -->
    <!-- <TreatWarningsAsErrors>true</TreatWarningsAsErrors> -->
  </PropertyGroup>

</Project>