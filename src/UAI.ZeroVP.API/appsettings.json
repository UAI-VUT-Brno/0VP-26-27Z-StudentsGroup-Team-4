{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "JsonFile": {
      "LogLevel": {
        "Default": "Information",
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "FileLogging": {
    "Enabled": true,
    "Directory": "logs",
    "FileNamePrefix": "zerovp",
    "RetainedFileCount": 14
  },
  "RequestLogging": {
    "ExcludedPaths": [ "/health" ]
  },
  "AllowedHosts": "*",
  "Todo": {
    "SeedSampleData": true
  },
  "JsonPersistence": {
    "Enabled": true,
    "FilePath": "data/todos.json"
  },
  "Swagger": {
    "Enabled": false
  }
}